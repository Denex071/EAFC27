rules_version = '2';
// Denex Trading – Regeln für das eigene Firebase-Projekt (NICHT für das private Depot-Projekt verwenden).
// Jeder sieht nur sein eigenes Depot bzw. Depots, in die er per Code eingeladen wurde.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function depot(id) { return get(/databases/$(database)/documents/depots/$(id)).data; }
    function onlyChanged(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    // Beta: Schreiben nur in den ersten 24 Stunden nach Anlage des Depots.
    // Ausnahme: Depot mit unlimited == true (nur in der Firebase-Konsole setzbar, z. B. für das eigene Konto).
    function betaOpen(d) { return d.get('unlimited', false) == true || request.time < d.created + duration.value(24, 'h'); }
    function namesOnlyOwn() {
      return !('names' in request.resource.data) || !('names' in resource.data)
        || request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([uid()]);
    }

    // Profil: nur man selbst
    match /users/{userId} {
      allow read, write: if signedIn() && uid() == userId;
    }

    match /depots/{depotId} {
      allow create: if signedIn() && request.resource.data.owner == uid() && request.resource.data.members == [uid()]
        && request.resource.data.created == request.time && !('unlimited' in request.resource.data);
      allow read: if signedIn() && uid() in resource.data.members;
      allow delete: if signedIn() && resource.data.owner == uid();
      allow update: if signedIn() && (
        // Besitzer: darf alles außer den Besitzer ändern und muss Mitglied bleiben
        (resource.data.owner == uid() && request.resource.data.owner == resource.data.owner && uid() in request.resource.data.members
          && request.resource.data.created == resource.data.created
          && request.resource.data.get('unlimited', false) == resource.data.get('unlimited', false))
        // Mitglied: nur den eigenen Namen ändern
        || (uid() in resource.data.members && onlyChanged(['names']) && namesOnlyOwn())
        // Beitreten (mit Code): nur sich selbst hinzufügen, höchstens 5 Mitglieder
        || (onlyChanged(['members', 'names']) && namesOnlyOwn()
            && request.resource.data.members.hasAll(resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() + 1
            && uid() in request.resource.data.members
            && request.resource.data.members.size() <= 5)
        // Verlassen: nur sich selbst entfernen
        || (onlyChanged(['members', 'names']) && namesOnlyOwn()
            && resource.data.members.hasAll(request.resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() - 1
            && uid() in resource.data.members && !(uid() in request.resource.data.members))
      );

      // Daten (players, snapshots, chemIcons, settings): alle Mitglieder
      match /{collection}/{docId} {
        allow read: if signedIn() && uid() in depot(depotId).members;
        allow create, update: if signedIn() && uid() in depot(depotId).members && betaOpen(depot(depotId));
        allow delete: if signedIn() && uid() in depot(depotId).members; // Löschen (z. B. Konto löschen) auch nach der Beta
      }
    }

    // Einladungscodes: lesen nur gezielt per Code (kein Auflisten), anlegen/löschen nur durch den Depot-Besitzer
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.owner == uid() && depot(request.resource.data.depotId).owner == uid();
      allow delete: if signedIn() && resource.data.owner == uid();
    }
  }
}
